{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-console",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tucked/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-expo-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tucked/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
